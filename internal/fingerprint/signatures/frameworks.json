[
  {
    "name": "React",
    "categories": ["javascript-framework"],
    "matchers": [
      { "type": "body", "pattern": "data-reactroot|data-reactid|__REACT_DEVTOOLS_GLOBAL_HOOK__", "weight": 70 },
      { "type": "script-src", "pattern": "/react(?:-dom)?[.@-]?([0-9.]+)?(?:\\.min)?\\.js", "version": 1, "weight": 60 },
      { "type": "body", "pattern": "_reactListening|ReactDOM\\.(?:render|createRoot)", "weight": 55 }
    ]
  },
  {
    "name": "Next.js",
    "categories": ["javascript-framework", "ssr"],
    "implies": ["React", "Node.js"],
    "matchers": [
      { "type": "body", "pattern": "__NEXT_DATA__", "weight": 85 },
      { "type": "script-src", "pattern": "/_next/static/", "weight": 75 },
      { "type": "header", "name": "x-powered-by", "pattern": "Next\\.js\\s*([0-9.]+)?", "version": 1, "weight": 85 },
      { "type": "header", "name": "x-nextjs-cache", "pattern": ".", "weight": 70 }
    ]
  },
  {
    "name": "Vue.js",
    "categories": ["javascript-framework"],
    "matchers": [
      { "type": "body", "pattern": "data-v-[0-9a-f]{8}|__VUE_DEVTOOLS_GLOBAL_HOOK__", "weight": 70 },
      { "type": "script-src", "pattern": "/vue[.@-]?([0-9.]+)?(?:\\.min|\\.runtime)?\\.js", "version": 1, "weight": 60 },
      { "type": "body", "pattern": "\\bv-(?:if|for|bind|model)=", "weight": 45 }
    ]
  },
  {
    "name": "Nuxt",
    "categories": ["javascript-framework", "ssr"],
    "implies": ["Vue.js", "Node.js"],
    "matchers": [
      { "type": "body", "pattern": "__NUXT__|__nuxt", "weight": 80 },
      { "type": "script-src", "pattern": "/_nuxt/", "weight": 75 }
    ]
  },
  {
    "name": "Angular",
    "categories": ["javascript-framework"],
    "matchers": [
      { "type": "body", "pattern": "ng-version=\"([0-9.]+)\"", "version": 1, "weight": 85 },
      { "type": "body", "pattern": "\\bng-(?:app|controller|repeat)=", "weight": 55 },
      { "type": "script-src", "pattern": "/(?:angular|zone)[.@-]?([0-9.]+)?(?:\\.min)?\\.js", "version": 1, "weight": 55 }
    ]
  },
  {
    "name": "Svelte",
    "categories": ["javascript-framework"],
    "matchers": [
      { "type": "class", "pattern": "\\bsvelte-[a-z0-9]{6}\\b", "weight": 70 },
      { "type": "body", "pattern": "__sveltekit_|/_app/immutable/", "weight": 75 }
    ]
  },
  {
    "name": "jQuery",
    "categories": ["javascript-library"],
    "matchers": [
      { "type": "script-src", "pattern": "jquery[.-]?([0-9]+\\.[0-9.]+)?(?:\\.min)?\\.js", "version": 1, "weight": 75 },
      { "type": "body", "pattern": "jQuery\\.fn\\.jquery|\\$\\(document\\)\\.ready", "weight": 45 }
    ]
  },
  {
    "name": "Bootstrap",
    "categories": ["css-framework"],
    "matchers": [
      { "type": "script-src", "pattern": "bootstrap[.-]?([0-9]+\\.[0-9.]+)?(?:\\.bundle)?(?:\\.min)?\\.js", "version": 1, "weight": 70 },
      { "type": "body", "pattern": "bootstrap(?:\\.min)?\\.css", "weight": 55 },
      { "type": "class", "pattern": "\\b(?:col-(?:xs|sm|md|lg|xl)-\\d+|navbar-(?:toggler|brand))\\b", "weight": 40 }
    ]
  },
  {
    "name": "Tailwind CSS",
    "categories": ["css-framework"],
    "matchers": [
      { "type": "body", "pattern": "tailwind(?:css)?(?:\\.min)?\\.css|cdn\\.tailwindcss\\.com", "weight": 70 },
      { "type": "class", "pattern": "\\b(?:flex\\s+items-center|text-(?:sm|lg|xl)\\s|bg-(?:gray|slate|blue)-[0-9]{2,3})", "weight": 45 }
    ]
  },
  {
    "name": "Gatsby",
    "categories": ["static-site-generator"],
    "implies": ["React"],
    "matchers": [
      { "type": "body", "pattern": "___gatsby|gatsby-(?:image|link)", "weight": 80 },
      { "type": "meta", "name": "generator", "pattern": "Gatsby\\s*([0-9.]+)?", "version": 1, "weight": 85 }
    ]
  },
  {
    "name": "Hugo",
    "categories": ["static-site-generator"],
    "matchers": [
      { "type": "meta", "name": "generator", "pattern": "Hugo\\s*([0-9.]+)?", "version": 1, "weight": 90 }
    ]
  },
  {
    "name": "Jekyll",
    "categories": ["static-site-generator"],
    "matchers": [
      { "type": "meta", "name": "generator", "pattern": "Jekyll\\s*v?([0-9.]+)?", "version": 1, "weight": 90 }
    ]
  },
  {
    "name": "Astro",
    "categories": ["static-site-generator"],
    "matchers": [
      { "type": "meta", "name": "generator", "pattern": "Astro\\s*v?([0-9.]+)?", "version": 1, "weight": 90 },
      { "type": "body", "pattern": "astro-island|data-astro-cid", "weight": 70 }
    ]
  }
]
